# ============================================================================
# PORTAL PILOT — Variables de Entorno de Referencia
# Copia este archivo como `.env` (desarrollo local) o configúralo en Vercel.
# NUNCA subas `.env` con credenciales reales al repositorio.
# ============================================================================

# --- Servidor & Dominios ---
PORT=5173
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PRIMARY_DOMAIN=https://portal-pilot.vercel.app
APP_URL=https://portal-pilot.vercel.app

# --- Seguridad & Cifrado ---
# Usa al menos 64 caracteres aleatorios en producción
JWT_SECRET=reemplazar_con_secreto_jwt_largo_y_aleatorio
SESSION_SECRET=reemplazar_con_secreto_de_sesion_aleatorio
INTEGRATION_ENCRYPTION_KEY=reemplazar_con_clave_cifrado_32_bytes_minimo
BILLING_WEBHOOK_SECRET=reemplazar_con_secreto_webhook_de_pagos
PING_SECRET=reemplazar_con_secreto_post_deploy_ping

# --- Supabase (Backend usa SERVICE_ROLE_KEY) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
SUPABASE_ANON_KEY=tu_supabase_anon_key

# --- Inteligencia Artificial (Proxy seguro en backend) ---
GROQ_API_KEY=gsk_tu_groq_api_key
# Opcionales / respaldo multi-proveedor:
# MISTRAL_API_KEY=
# HUGGINGFACE_API_KEY=
# ZAI_API_KEY=

# --- Correo Transaccional (SMTP / Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=tu_app_password_smtp
EMAIL_FROM="Portal Pilot <notificaciones@tudominio.com>"
EMAIL_REPLY_TO=soporte@portalpilot.hn

# --- Integración Google OAuth2 (Opcional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://portal-pilot.vercel.app/api/integrations/google/callback
