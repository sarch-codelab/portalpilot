{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "EMAIL PORTAL PILOT/**",
          "enterprise/**"
        ]
      }
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.png",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.ico",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "/$1"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/tenants",
      "dest": "/pp/tenants.html"
    },
    {
      "src": "/dashboard",
      "dest": "/pp/dashboard.html"
    },
    {
      "src": "/usuarios",
      "dest": "/pp/usuarios.html"
    },
    {
      "src": "/global_settings",
      "dest": "/pp/global_settings.html"
    },
    {
      "src": "/billing_plans",
      "dest": "/pp/billing_plans.html"
    },
    {
      "src": "/perfil",
      "dest": "/pp/perfil.html"
    },
    {
      "src": "/primer_acceso",
      "dest": "/primer_acceso.html"
    },
    {
      "src": "/inicio",
      "dest": "/pp/welcome.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
