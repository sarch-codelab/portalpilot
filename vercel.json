{
  "version": 2,
  "builds": [
    {
      "src": "api/ping-search-engines.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/support-ticket.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "EMAIL PORTAL PILOT/**",
          "pp/**",
          "empresa/**"
        ]
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "pp/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "empresa/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "css/**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "pp/css/**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "auth-check.js",
      "use": "@vercel/static"
    },
    {
      "src": "index.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "pp/js/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.png",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.ico",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
      },
      "continue": true
    },
    {
      "src": "^/backend(/.*)?$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "^/enterprise/([^/]+)\\.html$",
      "headers": { "Location": "/enterprise/$1" },
      "status": 308
    },
    {
      "src": "/enterprise(/.*)?",
      "dest": "/backend/server.js"
    },
    {
      "src": "^/pp/([^/]+)\\.html$",
      "headers": { "Location": "/pp/$1" },
      "status": 308
    },
    {
      "src": "/pp(/.*)?",
      "dest": "/backend/server.js"
    },
    {
      "src": "^/empresa/([^/]+)\\.html$",
      "headers": { "Location": "/empresa/$1" },
      "status": 308
    },
    {
      "src": "/empresa(/.*)?",
      "dest": "/backend/server.js"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/api/ping-search-engines",
      "dest": "/api/ping-search-engines.js"
    },
    {
      "src": "/api/support-ticket",
      "dest": "/api/support-ticket.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "^/(auth-check\\.js|index\\.js|js/.*\\.js|pp/js/.*\\.js)$",
      "dest": "/$1"
    },
    {
      "src": "^/(index\\.css|css/.*\\.css|pp/css/.*\\.css)$",
      "dest": "/$1"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/registro.html",
      "dest": "/registrov2.html"
    },
    {
      "src": "/registro",
      "dest": "/registrov2.html"
    },
    {
      "src": "/tenants",
      "dest": "/backend/server.js"
    },
    {
      "src": "/dashboard",
      "dest": "/backend/server.js"
    },
    {
      "src": "/usuarios",
      "dest": "/backend/server.js"
    },
    {
      "src": "/global_settings",
      "dest": "/backend/server.js"
    },
    {
      "src": "/billing_plans",
      "dest": "/backend/server.js"
    },
    {
      "src": "/bots_rpa",
      "dest": "/backend/server.js"
    },
    {
      "src": "/auditoria",
      "dest": "/backend/server.js"
    },
    {
      "src": "/analytics",
      "dest": "/backend/server.js"
    },
    {
      "src": "/system_health",
      "dest": "/backend/server.js"
    },
    {
      "src": "/perfil",
      "dest": "/backend/server.js"
    },
    {
      "src": "/primer_acceso",
      "dest": "/primer_acceso.html"
    },
    {
      "src": "/inicio",
      "dest": "/backend/server.js"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/index\\.html$",
      "headers": { "Location": "/" },
      "status": 308
    },
    {
      "src": "^/([^/]+)\\.html$",
      "headers": { "Location": "/$1" },
      "status": 308
    },
    {
      "src": "^/([^/.]+)$",
      "dest": "/$1.html"
    }
  ]
}
