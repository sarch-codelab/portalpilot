{
  "version": 2,
  "builds": [
    {
      "src": "api/ping-search-engines.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/support-ticket.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "EMAIL PORTAL PILOT/**",
          "empresa/**"
        ]
      }
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.png",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.ico",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/enterprise/(.*)",
      "dest": "/empresa/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/api/ping-search-engines",
      "dest": "/api/ping-search-engines.js"
    },
    {
      "src": "/api/support-ticket",
      "dest": "/api/support-ticket.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "/$1"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/registro.html",
      "dest": "/registrov2.html"
    },
    {
      "src": "/registro",
      "dest": "/registrov2.html"
    },
    {
      "src": "/tenants",
      "dest": "/pp/tenants.html"
    },
    {
      "src": "/dashboard",
      "dest": "/pp/dashboard.html"
    },
    {
      "src": "/usuarios",
      "dest": "/pp/usuarios.html"
    },
    {
      "src": "/global_settings",
      "dest": "/pp/global_settings.html"
    },
    {
      "src": "/billing_plans",
      "dest": "/pp/billing_plans.html"
    },
    {
      "src": "/bots_rpa",
      "dest": "/pp/bots_rpa.html"
    },
    {
      "src": "/auditoria",
      "dest": "/pp/auditoria.html"
    },
    {
      "src": "/analytics",
      "dest": "/pp/analytics.html"
    },
    {
      "src": "/system_health",
      "dest": "/pp/system_health.html"
    },
    {
      "src": "/perfil",
      "dest": "/pp/perfil.html"
    },
    {
      "src": "/primer_acceso",
      "dest": "/primer_acceso.html"
    },
    {
      "src": "/inicio",
      "dest": "/pp/welcome.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
